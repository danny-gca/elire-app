  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/build-data.ts",
    "simulate:scoring": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/simulate-scoring.ts 25000 2027",
